{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/event.schema.json",
  "title": "Peristiwa Sejarah Indonesia",
  "type": "object",
  "properties": {
    "judul": {
      "type": "string",
      "description": "Judul peristiwa atau era"
    },
    "tanggal_mulai": {
      "type": "string",
      "format": "date",
      "description": "Tanggal mulai peristiwa (format: YYYY-MM-DD)"
    },
    "tanggal_selesai": {
      "type": "string",
      "format": "date",
      "description": "Tanggal selesai peristiwa (format: YYYY-MM-DD), opsional untuk peristiwa satu hari"
    },
    "deskripsi": {
      "type": "string",
      "description": "Deskripsi singkat peristiwa"
    },
    "lokasi": {
      "type": "array",
      "description": "Lokasi geografis peristiwa",
      "items": {
        "type": "string"
      }
    },
    "tokoh": {
      "type": "array",
      "description": "Daftar tokoh yang terlibat dalam peristiwa",
      "items": {
        "type": "string"
      }
    },
    "sumber": {
      "type": "array",
      "description": "Sumber dokumentasi dan data peristiwa",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "judul": { "type": "string", "description": "Judul atau nama sumber" },
              "url": { "type": "string", "format": "uri", "description": "URL ke sumber" },
              "tipe": { "type": "string", "description": "Jenis sumber (wikidata, wikipedia, jurnal, dll)" },
              "diakses": { "type": "string", "format": "date", "description": "Tanggal akses (format: YYYY-MM-DD)" }
            },
            "required": ["url"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["judul", "tanggal_mulai", "deskripsi"],
  "additionalProperties": false
}
